# .env.aistack.example - TEMPLATE, safe to commit.
#
# Copy to .env.aistack (gitignored) and fill in real values before bringing
# the stack up:
#   cp .env.aistack.example .env.aistack
#
# ARI_PASSWORD must match docker/etc-asterisk/secrets/ari_secret.conf's
# [aistack] password (see secrets/ari_secret.conf.example).
ARI_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# TUNNEL_TOKEN: Cloudflare Tunnel token for the cloudflared service. Must be
# named exactly TUNNEL_TOKEN -- that's the env var cloudflared itself reads.
# Create a token-based tunnel in the Cloudflare Zero Trust dashboard, set
# its public hostname ingress to sip.w3.run -> http://caddy:80 (NOT
# localhost:7231 -- cloudflared reaches Caddy over the aistack docker
# network), then paste the token here.
TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_TUNNEL_TOKEN
