# Keep the build context reasonably small and let the container do its own
# fresh build (the Dockerfile runs `make distclean` before configuring, so
# host build artifacts below are cleaned up inside the image regardless --
# these excludes just avoid shipping them across the docker build context).

.git
.gitignore

# Docker's own files (no need to send them to the daemon as "context")
Dockerfile
compose.yml
docker-compose.yml
.dockerignore
docker/

# Host build output / caches — rebuilt fresh in the container anyway.
# Excluding them here keeps the build context upload fast.
**/*.o
**/*.lo
**/*.so
**/*.a
**/.libs/
**/.deps/
autom4te.cache/
doc/api/

# Host ./configure + make state — regenerated by `make distclean` and a
# fresh ./configure inside the builder stage (see Dockerfile). Excluding
# them here just avoids uploading them as build context.
config.log
config.status
config.cache
makeopts
makeopts.xml
menuselect.makeopts
menuselect-tree
menuselect.makedeps
include/asterisk/autoconfig.h
include/asterisk/buildopts.h

# Editor/OS cruft
.vscode/
.idea/
*.swp
.DS_Store
