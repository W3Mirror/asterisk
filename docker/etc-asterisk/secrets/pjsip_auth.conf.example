; pjsip_auth.conf.example - TEMPLATE, safe to commit.
;
; Copy to pjsip_auth.conf (gitignored) and set a real password before
; bringing the stack up:
;   cp pjsip_auth.conf.example pjsip_auth.conf
;   openssl rand -hex 16   # or rand -base64 18 -- avoid ; # [ ] = in the output
;
; #include'd from ../pjsip.conf.

[6001]
type=auth
auth_type=userpass
username=6001
password=REPLACE_WITH_A_STRONG_PASSWORD
