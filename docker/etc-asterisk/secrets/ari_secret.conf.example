; ari_secret.conf.example - TEMPLATE, safe to commit.
;
; Copy to ari_secret.conf (gitignored) and set a real password before
; bringing the stack up:
;   cp ari_secret.conf.example ari_secret.conf
;   openssl rand -hex 16   # or rand -base64 18 -- avoid ; # [ ] = in the output
;
; Keep this in sync with .env.aistack's ARI_PASSWORD (the portal reads that
; one at runtime to talk to ARI).
;
; #include'd from ../ari.conf.

[aistack]
type = user
read_only = no
password = REPLACE_WITH_A_STRONG_PASSWORD
