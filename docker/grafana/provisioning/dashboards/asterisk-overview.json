{
  "title": "Asterisk Overview",
  "uid": "asterisk-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Core Uptime",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "asterisk_core_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Seconds Since Last Reload",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "asterisk_core_last_reload_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prometheus Scrape Duration (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "asterisk_core_scrape_time_ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Up (1 = Prometheus reached Asterisk /metrics)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "up{job=\"asterisk\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
